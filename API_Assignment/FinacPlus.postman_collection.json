	"item": [
		{
			"name": "POST Create User",
			"item": [
				{
					"name": "New User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));\r",
									"\r",
									"const responseBody = pm.response.json();\r",
									"\r",
									"// Validate id exists and store for later\r",
									"pm.expect(responseBody.id).to.exist;\r",
									"pm.environment.set(\"userId\", responseBody.id);\r",
									"\r",
									"pm.test(\"ResponseBody fields Validation\", () => {\r",
									"  pm.expect(responseBody.name).to.eql(pm.environment.get(\"newUserName\"));\r",
									"  pm.expect(responseBody.job).to.eql(\"QA Engineer\");\r",
									"});\r",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "",
								"value": "",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\r\n  \"name\": \"{{newUserName}}\",\r\n  \"job\": \"QA Engineer\"\r\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/users",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "GET User Details",
			"item": [
				{
					"name": "User Details",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const code = pm.response.code;\r",
									"\r",
									"if (code === 200) {\r",
									"  pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));\r",
									"  const json = pm.response.json();\r",
									"  pm.expect(json.data).to.be.an(\"object\");\r",
									"} else if (code === 404) {\r",
									"  pm.test(\"Expected 404 (non-persistent sandbox)\", () => pm.expect(code).to.eql(404));\r",
									"} else {\r",
									"  pm.test(\"Unexpected status\", () => pm.expect.fail(`Got ${code}`));\r",
									"}\r",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"protocolProfileBehavior": {
						"disableBodyPruning": true
					},
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "",
								"value": "",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": ""
						},
						"url": {
							"raw": "{{base_url}}/api/users/{{userId}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users",
								"{{userId}}"
							]
						}
					},
					"response": []
				}
			]
		},
